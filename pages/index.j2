{% extends "templates/base.j2" %}

{% block extra_css %}
    <link rel="stylesheet" href="{{ './static/css/destination_carousel.css' | versioned }}">
{% endblock %}

{% block content %}
<main id="main-content">
    <!-- Hero Section com Identidade Visual PyNE 2027 -->
    <section id="hero" class="hero-section">
        <div class="hero-container">
            
            <!-- Badge de Localização e Ano -->
            {% if event.location and event.location.city %}
            <div class="location-badge hero-animate-1">
                <i class="fa-solid fa-location-dot badge-pin" aria-hidden="true"></i>
                <span class="badge-text">{{ event.location.city }}, {{ event.location.state }} • {{ event.edition }}</span>
            </div>
            {% endif %}

            <!-- Logo Oficial PyNE 2027 com levitação e suporte a 3D tilt -->
            <div class="logo-wrapper hero-animate-2">
                <div class="logo-tilt-container" id="logo-tilt">
                    <img 
                        src="{{ theme.logo }}" 
                        alt="Logo Oficial {{ event.name }} {{ event.edition }}" 
                        class="hero-logo"
                        id="hero-logo"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                    />
                </div>
            </div>

            <!-- Título e Subtítulo -->
            <div class="hero-text-content hero-animate-3">
                <h1 class="hero-title">{{ event.name }} <span class="edition-highlight">{{ event.edition }}</span></h1>
                
                {% if event.tagline %}
                <p class="hero-tagline">{{ event.tagline }}</p>
                {% endif %}

                {% if event.description %}
                <p class="hero-description">{{ event.description }}</p>
                {% endif %}
            </div>

            <!-- Data e Local do Evento -->
            {% set location = event.location or {} %}
            {% if event.date or location.venue %}
            <ul class="event-details hero-animate-3" aria-label="Data e local do evento">
                {% if event.date %}
                <li class="event-detail">
                    <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                    {% if event.start_date %}
                    <time datetime="{{ event.start_date }}{% if event.end_date %}/{{ event.end_date }}{% endif %}">{{ event.date }}</time>
                    {% else %}
                    <span>{{ event.date }}</span>
                    {% endif %}
                </li>
                {% endif %}
                {% if location.venue %}
                {% set venue_text = location.venue ~ ((', em ' ~ location.city ~ ', ' ~ (location.state_code or location.state)) if location.city else '') %}
                <li class="event-detail">
                    <i class="fa-solid fa-building-columns" aria-hidden="true"></i>
                    {% if location.map_url %}
                    <a href="{{ location.map_url }}" target="_blank" rel="noopener noreferrer"{% if location.venue_full_name %} title="{{ location.venue_full_name }}"{% endif %}>{{ venue_text }}</a>
                    {% else %}
                    <span{% if location.venue_full_name %} title="{{ location.venue_full_name }}"{% endif %}>{{ venue_text }}</span>
                    {% endif %}
                </li>
                {% endif %}
            </ul>
            {% endif %}

            <!-- Botões de Ação Condicionais -->
            {% if actions and (actions.tickets_url or actions.call_for_papers_url) %}
            <div class="action-buttons hero-animate-4">
                {% if actions.tickets_url %}
                <a href="{{ actions.tickets_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary" id="btn-tickets">
                    <i class="fa-solid fa-ticket" aria-hidden="true"></i> Garantir Ingresso
                </a>
                {% endif %}
                {% if actions.call_for_papers_url %}
                <a href="{{ actions.call_for_papers_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" id="btn-cfp">
                    <i class="fa-solid fa-bullhorn" aria-hidden="true"></i> Submeter Palestra
                </a>
                {% endif %}
            </div>
            {% endif %}

            <!-- Redes Sociais da Comunidade -->
            <div class="social-section hero-animate-5">
                <p class="social-call">Acompanhe as novidades da comunidade:</p>
                <div class="social-badges">
                    {% if social.instagram %}
                    <a href="{{ social.instagram }}" target="_blank" rel="noopener noreferrer" class="social-pill instagram" aria-label="Instagram">
                        <i class="fa-brands fa-instagram" aria-hidden="true"></i> Instagram
                    </a>
                    {% endif %}
                    {% if social.linkedin %}
                    <a href="{{ social.linkedin }}" target="_blank" rel="noopener noreferrer" class="social-pill linkedin" aria-label="LinkedIn">
                        <i class="fa-brands fa-linkedin" aria-hidden="true"></i> LinkedIn
                    </a>
                    {% endif %}
                    {% if social.youtube %}
                    <a href="{{ social.youtube }}" target="_blank" rel="noopener noreferrer" class="social-pill youtube" aria-label="YouTube">
                        <i class="fa-brands fa-youtube" aria-hidden="true"></i> YouTube
                    </a>
                    {% endif %}
                    {% if social.telegram %}
                    <a href="{{ social.telegram }}" target="_blank" rel="noopener noreferrer" class="social-pill telegram" aria-label="Telegram">
                        <i class="fa-brands fa-telegram" aria-hidden="true"></i> Telegram
                    </a>
                    {% endif %}
                    {% if social.github %}
                    <a href="{{ social.github }}" target="_blank" rel="noopener noreferrer" class="social-pill github" aria-label="GitHub">
                        <i class="fa-brands fa-github" aria-hidden="true"></i> GitHub
                    </a>
                    {% endif %}
                </div>
            </div>

        </div>
    </section>

    <!-- Carrossel de atrações de Parnaíba e região -->
    <section id="destination" class="destination-section">
        <div class="section-header">
            <span class="section-tag"><i class="fa-solid fa-compass" aria-hidden="true"></i> Destino {{ event.edition }}</span>
            <h2 class="section-title"><i class="fa-solid fa-umbrella-beach" aria-hidden="true"></i> Parnaíba espera por você</h2>
            <p class="section-subtitle">
                O litoral do Piauí combina natureza exuberante, dunas paradisíacas e o acolhimento caloroso da nossa comunidade.
            </p>
        </div>

        {% if destination_slides %}
        <div class="destination-carousel" id="destination-carousel" role="region" aria-roledescription="carrossel" aria-label="Atrações de Parnaíba e região">
            <div class="carousel-viewport">
                <ul class="carousel-track" tabindex="0" aria-label="Fotos e descrições das atrações">
                    {% for slide in destination_slides %}
                    <li class="carousel-slide" id="destination-slide-{{ loop.index }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} de {{ loop.length }}: {{ slide.title }}">
                        <figure class="slide-card">
                            <div class="slide-media">
                                <img src="{{ slide.image }}" alt="{{ slide.alt or slide.title }}" loading="lazy" decoding="async">
                            </div>
                            <figcaption class="slide-caption">
                                <span class="slide-counter" aria-hidden="true">{{ '%02d' % loop.index }} / {{ '%02d' % loop.length }}</span>
                                <h3 class="slide-title">{{ slide.title }}</h3>
                                <p class="slide-description">{{ slide.description }}</p>
                            </figcaption>
                        </figure>
                    </li>
                    {% endfor %}
                </ul>
            </div>

            <!-- Controles: exibidos apenas quando o JavaScript está ativo -->
            <div class="carousel-controls" hidden>
                <button type="button" class="carousel-button" data-carousel-prev aria-controls="destination-carousel" aria-label="Atração anterior">
                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                </button>
                <div class="carousel-dots">
                    {% for slide in destination_slides %}
                    <button type="button" class="carousel-dot" data-carousel-dot="{{ loop.index0 }}" aria-controls="destination-slide-{{ loop.index }}" aria-label="Ir para {{ slide.title }}"></button>
                    {% endfor %}
                </div>
                <button type="button" class="carousel-button" data-carousel-next aria-controls="destination-carousel" aria-label="Próxima atração">
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </button>
                <button type="button" class="carousel-button carousel-toggle" data-carousel-toggle aria-label="Pausar troca automática">
                    <i class="fa-solid fa-pause" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        {% endif %}
    </section>

    <!-- Local do Evento: foto e mapa -->
    {% set location = event.location or {} %}
    {% if location.venue %}
    <section id="venue" class="venue-section">
        <div class="section-header">
            <span class="section-tag"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Local do evento</span>
            <h2 class="section-title"><i class="fa-solid fa-building-columns" aria-hidden="true"></i> {{ location.venue }}</h2>
            {% if location.venue_full_name %}
            <p class="section-subtitle">{{ location.venue_full_name }}</p>
            {% endif %}
        </div>

        <div class="venue-grid">
            <figure class="venue-photo{% if not location.photo %} is-placeholder{% endif %}">
                {% if location.photo %}
                <img src="{{ location.photo }}" alt="{{ location.photo_alt or ('Foto da ' ~ location.venue) }}" loading="lazy" decoding="async">
                {% else %}
                <div class="venue-photo-placeholder">
                    <i class="fa-solid fa-camera" aria-hidden="true"></i>
                    <span>Foto do local em breve</span>
                </div>
                {% endif %}
            </figure>

            {% set map_query = location.map_query or (location.venue ~ ', ' ~ location.city ~ ' - ' ~ (location.state_code or location.state)) %}
            <div class="venue-map">
                <iframe
                    src="https://www.google.com/maps?q={{ map_query | urlencode }}&amp;output=embed"
                    title="Mapa com a localização da {{ location.venue }}"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen></iframe>
            </div>
        </div>

        <div class="venue-info">
            <p class="venue-address">
                <i class="fa-solid fa-map-pin" aria-hidden="true"></i>
                <span>
                    {% if location.address %}{{ location.address }}, {% endif %}{{ location.city }} - {{ location.state_code or location.state }}
                </span>
            </p>
            {% if location.map_url %}
            <a href="{{ location.map_url }}" target="_blank" rel="noopener noreferrer" class="venue-directions">
                <i class="fa-solid fa-diamond-turn-right" aria-hidden="true"></i> Como chegar
            </a>
            {% endif %}
        </div>
    </section>
    {% endif %}
</main>
{% endblock %}

{% block extra_js %}
    <script src="{{ './static/js/destination_carousel.js' | versioned }}"></script>
    <script src="{{ './static/js/hero_animations.js' | versioned }}"></script>
{% endblock %}