{% extends "templates/base.j2" %}

{% block extra_css %}
    <link rel="stylesheet" href="./static/css/destination_carousel.css">
{% endblock %}

{% block content %}
<main id="main-content">
    <!-- Hero Section com Identidade Visual PyNE 2027 -->
    <section id="hero" class="hero-section">
        <!-- Revoada de Guarás no Céu do Hero (Voo dos 3 pássaros oficiais) -->
        <div class="hero-guara-flock" aria-hidden="true">
            <div class="flock-bird bird-lead" title="Guará líder">
                <div class="guara-flapper">
                    <img src="static/img/guara/guara_up.png" alt="" class="guara-frame frame-up" />
                    <img src="static/img/guara/guara_down.png" alt="" class="guara-frame frame-down" />
                </div>
            </div>
            <div class="flock-bird bird-wing-top" title="Guará asa superior">
                <div class="guara-flapper">
                    <img src="static/img/guara/guara_up.png" alt="" class="guara-frame frame-up" />
                    <img src="static/img/guara/guara_down.png" alt="" class="guara-frame frame-down" />
                </div>
            </div>
            <div class="flock-bird bird-wing-bottom" title="Guará asa inferior">
                <div class="guara-flapper">
                    <img src="static/img/guara/guara_up.png" alt="" class="guara-frame frame-up" />
                    <img src="static/img/guara/guara_down.png" alt="" class="guara-frame frame-down" />
                </div>
            </div>
        </div>

        <!-- Curvas de nível topográficas oficiais na lateral direita (Exata ID Visual) -->
        <div class="hero-contour-right" aria-hidden="true">
            <img src="static/img/brand/hero_contour_right.svg" alt="" class="hero-contour-right-svg" />
        </div>

        <div class="hero-container">
            
            <!-- Badge de Localização e Ano com Guará -->
            {% if event.location and event.location.city %}
            <div class="location-badge hero-animate-1">
                <span class="badge-guara-avatar" title="Guará-vermelho, guardião do Delta">
                    <img src="static/img/guara/guara.png" alt="" class="badge-guara-img" />
                </span>
                <span class="badge-text">{{ event.location.city }}, {{ event.location.state }} • {{ event.edition }}</span>
                <span class="badge-tag-pill">Delta do Parnaíba</span>
            </div>
            {% endif %}

            <!-- Logo Oficial Horizontal PyNE 2027 com levitação e suporte a 3D tilt -->
            <div class="hero-brand-lockup hero-animate-2">
                <div class="logo-tilt-container" id="logo-tilt">
                    <img 
                        src="{{ theme.logo_horizontal | default('static/img/brand/logo.svg') }}" 
                        alt="Logo Oficial {{ event.name }} {{ event.edition }}" 
                        class="hero-logo-horizontal"
                        id="hero-logo"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                    />
                </div>
                <h1 class="sr-only">{{ event.name }} {{ event.edition }}</h1>
            </div>

            <!-- Título e Subtítulo -->
            <div class="hero-text-content hero-animate-3">
                {% if event.tagline %}
                <p class="hero-tagline">{{ event.tagline }}</p>
                {% endif %}

                {% if event.description %}
                <p class="hero-description">{{ event.description }}</p>
                {% endif %}
            </div>

            <!-- Data e Local do Evento -->
            {% set location = event.location or {} %}
            {% if event.date or location.venue %}
            <ul class="event-details hero-animate-3" aria-label="Data e local do evento">
                {% if event.date %}
                <li class="event-detail">
                    <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                    {% if event.start_date %}
                    <time datetime="{{ event.start_date }}{% if event.end_date %}/{{ event.end_date }}{% endif %}">{{ event.date }}</time>
                    {% else %}
                    <span>{{ event.date }}</span>
                    {% endif %}
                </li>
                {% endif %}
                {% if location.venue %}
                {% set venue_text = location.venue ~ ((', em ' ~ location.city ~ ', ' ~ (location.state_code or location.state)) if location.city else '') %}
                <li class="event-detail">
                    <i class="fa-solid fa-building-columns" aria-hidden="true"></i>
                    {% if location.map_url %}
                    <a href="{{ location.map_url }}" target="_blank" rel="noopener noreferrer"{% if location.venue_full_name %} title="{{ location.venue_full_name }}"{% endif %}>{{ venue_text }}</a>
                    {% else %}
                    <span{% if location.venue_full_name %} title="{{ location.venue_full_name }}"{% endif %}>{{ venue_text }}</span>
                    {% endif %}
                </li>
                {% endif %}
            </ul>
            {% endif %}

            <!-- Botões de Ação Condicionais -->
            {% if actions and (actions.tickets_url or actions.call_for_papers_url) %}
            <div class="action-buttons hero-animate-4">
                {% if actions.tickets_url %}
                <a href="{{ actions.tickets_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary" id="btn-tickets">
                    <i class="fa-solid fa-ticket" aria-hidden="true"></i> Garantir Ingresso
                </a>
                {% endif %}
                {% if actions.call_for_papers_url %}
                <a href="{{ actions.call_for_papers_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" id="btn-cfp">
                    <i class="fa-solid fa-bullhorn" aria-hidden="true"></i> Submeter Palestra
                </a>
                {% endif %}
            </div>
            {% endif %}

            <!-- Redes Sociais da Comunidade -->
            <div class="social-section hero-animate-5">
                <p class="social-call">Acompanhe as novidades da comunidade:</p>
                <div class="social-badges">
                    {% if social.instagram %}
                    <a href="{{ social.instagram }}" target="_blank" rel="noopener noreferrer" class="social-pill instagram" aria-label="Instagram">
                        <i class="fa-brands fa-instagram" aria-hidden="true"></i> Instagram
                    </a>
                    {% endif %}
                    {% if social.linkedin %}
                    <a href="{{ social.linkedin }}" target="_blank" rel="noopener noreferrer" class="social-pill linkedin" aria-label="LinkedIn">
                        <i class="fa-brands fa-linkedin" aria-hidden="true"></i> LinkedIn
                    </a>
                    {% endif %}
                    {% if social.youtube %}
                    <a href="{{ social.youtube }}" target="_blank" rel="noopener noreferrer" class="social-pill youtube" aria-label="YouTube">
                        <i class="fa-brands fa-youtube" aria-hidden="true"></i> YouTube
                    </a>
                    {% endif %}
                    {% if social.telegram %}
                    <a href="{{ social.telegram }}" target="_blank" rel="noopener noreferrer" class="social-pill telegram" aria-label="Telegram">
                        <i class="fa-brands fa-telegram" aria-hidden="true"></i> Telegram
                    </a>
                    {% endif %}
                    {% if social.github %}
                    <a href="{{ social.github }}" target="_blank" rel="noopener noreferrer" class="social-pill github" aria-label="GitHub">
                        <i class="fa-brands fa-github" aria-hidden="true"></i> GitHub
                    </a>
                    {% endif %}
                </div>
            </div>

        </div>
    </section>

    <!-- Seção Sobre a Python Nordeste (Issue #02) -->
    {% if about %}
    <section id="about" class="about-section">
        <div class="about-container">
            <div class="section-header">
                {% if about.tag %}
                <span class="section-tag"><i class="fa-solid fa-users" aria-hidden="true"></i> {{ about.tag }}</span>
                {% endif %}
                <h2 class="section-title"><i class="fa-solid fa-seedling" aria-hidden="true"></i> {{ about.title }}</h2>
                {% if about.subtitle %}
                <p class="section-subtitle">{{ about.subtitle }}</p>
                {% endif %}
            </div>

            <div class="about-grid">
                <div class="about-text-column">
                    {% for paragraph in about.paragraphs %}
                    <p class="about-paragraph">{{ paragraph }}</p>
                    {% endfor %}
                    <div class="about-quote-card">
                        <div class="quote-watermark" aria-hidden="true">
                            <img src="static/img/brand/nordeste.svg" alt="" />
                        </div>
                        <i class="fa-solid fa-quote-left quote-icon" aria-hidden="true"></i>
                        <p class="quote-text">Não estamos aqui apenas por código. Estamos aqui pelas conexões humanas que o código torna possíveis.</p>
                        <span class="quote-author">— Comunidade Python</span>
                    </div>
                </div>

                {% if about.stats %}
                <div class="about-stats-column">
                    <div class="stats-grid">
                        {% for stat in about.stats %}
                        <div class="stat-card">
                            <div class="stat-icon-wrapper">
                                <i class="{{ stat.icon }}" aria-hidden="true"></i>
                            </div>
                            <div class="stat-number">{{ stat.number }}</div>
                            <div class="stat-label">{{ stat.label }}</div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </section>
    {% endif %}
    {# =========================================================================
       [EM ESPERA] Seção Destino com Casinhas do Porto das Barcas & Guará Interativo
       Comentada para manter a versão oficial de produção (Destino 2027 da main).
       Não remover — preservada para reativação futura.

    <!-- Seção Destino Parnaíba (Porto das Barcas, Delta e Litoral) -->
    <div class="casinhas-stage-card">
        <div class="casinhas-stage-header">
            <span class="stage-tag"><i class="fa-solid fa-landmark" aria-hidden="true"></i> Centro Histórico & Delta</span>
            <p class="stage-desc">Às margens do Rio Igaraçu, casarões coloniais do século XIX encontram o santuário ecológico do Delta do Parnaíba.</p>
        </div>

        <div class="casinhas-stage-scenery">
            <!-- Guará interativo com asas batendo e balão de fala -->
            <div class="guara-perch-element" id="interactive-guara" role="button" tabindex="0" aria-label="Guará-vermelho interativo, clique para ver a revoada">
                <div class="guara-speech-bubble" id="guara-speech">
                    <span class="speech-text">Clique em mim para a Revoada! 🪶</span>
                    <span class="speech-tail"></span>
                </div>
                <div class="guara-stage-flapper">
                    <div class="guara-flapper">
                        <img src="static/img/guara/guara_up.png" alt="" class="guara-frame frame-up" />
                        <img src="static/img/guara/guara_down.png" alt="Guará-vermelho" class="guara-frame frame-down" />
                    </div>
                </div>
                <button class="btn-trigger-revoada" id="btn-revoada" title="Disparar Revoada dos Guarás">
                    <i class="fa-solid fa-feather-pointed" aria-hidden="true"></i> Revoada dos Guarás
                </button>
            </div>

            <!-- Fachadas das Casinhas Coloniais do Porto das Barcas -->
            <div class="casinhas-street" aria-label="Fachadas coloniais do Porto das Barcas">
                <div class="casinha-card casinha-coral" title="Casinha Colonial Coral - Porto das Barcas">
                    <img src="static/img/casinhas/casinha_coral.svg" alt="Casinha colonial coral" class="casinha-vector" />
                    <span class="casinha-caption">Artesanato & Memória</span>
                </div>
                <div class="casinha-card casinha-amarela" title="Casinha Colonial Amarela - Porto das Barcas">
                    <img src="static/img/casinhas/casinha_amarela.svg" alt="Casinha colonial amarela" class="casinha-vector" />
                    <span class="casinha-caption">Porto das Barcas</span>
                </div>
                <div class="casinha-card casinha-azul" title="Casinha Colonial Azul - Porto das Barcas">
                    <img src="static/img/casinhas/casinha_azul.svg" alt="Casinha colonial azul" class="casinha-vector" />
                    <span class="casinha-caption">Cultura Piauiense</span>
                </div>
            </div>
            
            <!-- Linha d'água / Dunas na base das casinhas -->
            <div class="casinhas-waterfront" aria-hidden="true">
                <div class="water-wave wave-1"></div>
                <div class="water-wave wave-2"></div>
            </div>
        </div>
    </div>
    ========================================================================= #}

    <!-- Carrossel de atrações de Parnaíba e região -->
    <section id="destination" class="destination-section">
        <div class="section-header">
            <span class="section-tag"><i class="fa-solid fa-compass" aria-hidden="true"></i> Destino {{ event.edition }}</span>
            <h2 class="section-title"><i class="fa-solid fa-umbrella-beach" aria-hidden="true"></i> Parnaíba espera por você</h2>
            <p class="section-subtitle">
                O litoral do Piauí combina natureza exuberante, dunas paradisíacas e o acolhimento caloroso da nossa comunidade.
            </p>
        </div>

        {% if destination_slides %}
        <div class="destination-carousel" id="destination-carousel" role="region" aria-roledescription="carrossel" aria-label="Atrações de Parnaíba e região">
            <div class="carousel-viewport">
                <ul class="carousel-track" tabindex="0" aria-label="Fotos e descrições das atrações">
                    {% for slide in destination_slides %}
                    <li class="carousel-slide" id="destination-slide-{{ loop.index }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} de {{ loop.length }}: {{ slide.title }}">
                        <figure class="slide-card">
                            <div class="slide-media">
                                <img src="{{ slide.image }}" alt="{{ slide.alt or slide.title }}" loading="lazy" decoding="async">
                            </div>
                            <figcaption class="slide-caption">
                                <span class="slide-counter" aria-hidden="true">{{ '%02d' % loop.index }} / {{ '%02d' % loop.length }}</span>
                                <h3 class="slide-title">{{ slide.title }}</h3>
                                <p class="slide-description">{{ slide.description }}</p>
                            </figcaption>
                        </figure>
                    </li>
                    {% endfor %}
                </ul>
            </div>

            <!-- Controles: exibidos apenas quando o JavaScript está ativo -->
            <div class="carousel-controls" hidden>
                <button type="button" class="carousel-button" data-carousel-prev aria-controls="destination-carousel" aria-label="Atração anterior">
                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                </button>
                <div class="carousel-dots">
                    {% for slide in destination_slides %}
                    <button type="button" class="carousel-dot" data-carousel-dot="{{ loop.index0 }}" aria-controls="destination-slide-{{ loop.index }}" aria-label="Ir para {{ slide.title }}"></button>
                    {% endfor %}
                </div>
                <button type="button" class="carousel-button" data-carousel-next aria-controls="destination-carousel" aria-label="Próxima atração">
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </button>
                <button type="button" class="carousel-button carousel-toggle" data-carousel-toggle aria-label="Pausar troca automática">
                    <i class="fa-solid fa-pause" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        {% endif %}
    </section>

    <!-- Local do Evento: foto e mapa -->
    {% set location = event.location or {} %}
    {% if location.venue %}
    <section id="venue" class="venue-section">
        <div class="section-header">
            <span class="section-tag"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Local do evento</span>
            <h2 class="section-title"><i class="fa-solid fa-building-columns" aria-hidden="true"></i> {{ location.venue }}</h2>
            {% if location.venue_full_name %}
            <p class="section-subtitle">{{ location.venue_full_name }}</p>
            {% endif %}
        </div>

        <div class="venue-grid">
            <figure class="venue-photo{% if not location.photo %} is-placeholder{% endif %}">
                {% if location.photo %}
                <img src="{{ location.photo }}" alt="{{ location.photo_alt or ('Foto da ' ~ location.venue) }}" loading="lazy" decoding="async">
                {% else %}
                <div class="venue-photo-placeholder">
                    <i class="fa-solid fa-camera" aria-hidden="true"></i>
                    <span>Foto do local em breve</span>
                </div>
                {% endif %}
            </figure>

            {% set map_query = location.map_query or (location.venue ~ ', ' ~ location.city ~ ' - ' ~ (location.state_code or location.state)) %}
            <div class="venue-map">
                <iframe
                    src="https://maps.google.com/maps?q={{ map_query | urlencode }}&amp;output=embed"
                    title="Mapa com a localização da {{ location.venue }}"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen></iframe>
            </div>
        </div>

        <div class="venue-info">
            <p class="venue-address">
                <i class="fa-solid fa-map-pin" aria-hidden="true"></i>
                <span>
                    {% if location.address %}{{ location.address }}, {% endif %}{{ location.city }} - {{ location.state_code or location.state }}
                </span>
            </p>
            {% if location.map_url %}
            <a href="{{ location.map_url }}" target="_blank" rel="noopener noreferrer" class="venue-directions">
                <i class="fa-solid fa-diamond-turn-right" aria-hidden="true"></i> Como chegar
            </a>
            {% endif %}
        </div>
    </section>
    {% endif %}

    <!-- Camada Dinâmica da Revoada dos Guarás (Easter Egg) -->
    <div id="revoada-canvas-container" class="revoada-container" aria-hidden="true"></div>
    <div id="revoada-toast" class="revoada-toast" role="status" aria-live="polite">
        <i class="fa-solid fa-feather-pointed toast-icon" aria-hidden="true"></i>
        <div class="toast-content">
            <strong class="toast-title">Revoada no Delta das Américas!</strong>
            <span class="toast-msg">O espetáculo do Guará-vermelho em Parnaíba • Pessoas &gt; Tecnologia</span>
        </div>
    </div>
</main>
{% endblock %}

{% block extra_js %}
    <script src="./static/js/destination_carousel.js"></script>
    <script src="./static/js/hero_animations.js"></script>
{% endblock %}