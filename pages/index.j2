{% extends "templates/base.j2" %}

{% block extra_css %}
    <link rel="stylesheet" href="./static/css/phb_photos_animation.css">
{% endblock %}

{% block content %}
<header id="header">
    
    <div class="phb-photos">
        <div class="phb-photos-carousel">
        </div>
    </div>

    <div class="header-text">
        <br>
        <h1>{{ event.name }} {{ event.edition }}</h1>
        {% if event.location and event.location.city %}
        <h3>📍 {{ event.location.city }}, {{ event.location.state }}</h3>
        {% endif %}

        {% if event.tagline %}
        <p>{{ event.tagline }}</p>
        {% endif %}
        {% if event.description %}
        <p>{{ event.description }}</p>
        {% endif %}

        {% if actions and (actions.tickets_url or actions.call_for_papers_url) %}
        <div class="action-buttons">
            {% if actions.tickets_url %}<a href="{{ actions.tickets_url }}" target="_blank" class="btn-action">Garantir Ingresso</a>{% endif %}
            {% if actions.call_for_papers_url %}<a href="{{ actions.call_for_papers_url }}" target="_blank" class="btn-action">Submeter Palestra</a>{% endif %}
        </div>
        {% endif %}

        <div class="social-icons">
            <a href="{{ social.instagram | default('') }}" target="_blank">Instagram</a> |
            <a href="{{ social.linkedin | default('') }}" target="_blank">LinkedIn</a> |
            <a href="{{ social.youtube | default('') }}" target="_blank">YouTube</a>
            {% if social and social.telegram %} | <a href="{{ social.telegram }}" target="_blank">Telegram</a>{% endif %}
        </div>
    </div>

</header>
{% endblock %}

{% block extra_js %}
    <script src="./static/js/phb_photos_animation.js"></script>
{% endblock %}