{% extends "templates/base.j2" %}

{% block extra_css %}
    <link rel="stylesheet" href="./static/css/phb_photos_animation.css">
{% endblock %}

{% block content %}
<main id="main-content">
    <!-- Hero Section com Identidade Visual PyNE 2027 -->
    <section id="hero" class="hero-section">
        <div class="hero-container">
            
            <!-- Badge de Localização e Ano -->
            {% if event.location and event.location.city %}
            <div class="location-badge hero-animate-1">
                <i class="fa-solid fa-location-dot badge-pin" aria-hidden="true"></i>
                <span class="badge-text">{{ event.location.city }}, {{ event.location.state }} • {{ event.edition }}</span>
            </div>
            {% endif %}

            <!-- Logo Oficial PyNE 2027 com levitação e suporte a 3D tilt -->
            <div class="logo-wrapper hero-animate-2">
                <div class="logo-tilt-container" id="logo-tilt">
                    <img 
                        src="{{ theme.logo }}" 
                        alt="Logo Oficial {{ event.name }} {{ event.edition }}" 
                        class="hero-logo"
                        id="hero-logo"
                        loading="eager"
                    />
                </div>
            </div>

            <!-- Título e Subtítulo -->
            <div class="hero-text-content hero-animate-3">
                <h1 class="hero-title">{{ event.name }} <span class="edition-highlight">{{ event.edition }}</span></h1>
                
                {% if event.tagline %}
                <p class="hero-tagline">{{ event.tagline }}</p>
                {% endif %}

                {% if event.description %}
                <p class="hero-description">{{ event.description }}</p>
                {% endif %}
            </div>

            <!-- Botões de Ação Condicionais -->
            {% if actions and (actions.tickets_url or actions.call_for_papers_url) %}
            <div class="action-buttons hero-animate-4">
                {% if actions.tickets_url %}
                <a href="{{ actions.tickets_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary" id="btn-tickets">
                    <i class="fa-solid fa-ticket" aria-hidden="true"></i> Garantir Ingresso
                </a>
                {% endif %}
                {% if actions.call_for_papers_url %}
                <a href="{{ actions.call_for_papers_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" id="btn-cfp">
                    <i class="fa-solid fa-bullhorn" aria-hidden="true"></i> Submeter Palestra
                </a>
                {% endif %}
            </div>
            {% endif %}

            <!-- Redes Sociais da Comunidade -->
            <div class="social-section hero-animate-5">
                <p class="social-call">Acompanhe as novidades da comunidade:</p>
                <div class="social-badges">
                    {% if social.instagram %}
                    <a href="{{ social.instagram }}" target="_blank" rel="noopener noreferrer" class="social-pill instagram" aria-label="Instagram">
                        <i class="fa-brands fa-instagram" aria-hidden="true"></i> Instagram
                    </a>
                    {% endif %}
                    {% if social.linkedin %}
                    <a href="{{ social.linkedin }}" target="_blank" rel="noopener noreferrer" class="social-pill linkedin" aria-label="LinkedIn">
                        <i class="fa-brands fa-linkedin" aria-hidden="true"></i> LinkedIn
                    </a>
                    {% endif %}
                    {% if social.youtube %}
                    <a href="{{ social.youtube }}" target="_blank" rel="noopener noreferrer" class="social-pill youtube" aria-label="YouTube">
                        <i class="fa-brands fa-youtube" aria-hidden="true"></i> YouTube
                    </a>
                    {% endif %}
                    {% if social.telegram %}
                    <a href="{{ social.telegram }}" target="_blank" rel="noopener noreferrer" class="social-pill telegram" aria-label="Telegram">
                        <i class="fa-brands fa-telegram" aria-hidden="true"></i> Telegram
                    </a>
                    {% endif %}
                    {% if social.github %}
                    <a href="{{ social.github }}" target="_blank" rel="noopener noreferrer" class="social-pill github" aria-label="GitHub">
                        <i class="fa-brands fa-github" aria-hidden="true"></i> GitHub
                    </a>
                    {% endif %}
                </div>
            </div>

        </div>
    </section>

    <!-- Seção Sobre a Python Nordeste (Issue #02) -->
    {% if about %}
    <section id="about" class="about-section">
        <div class="about-container">
            <div class="section-header">
                {% if about.tag %}
                <span class="section-tag"><i class="fa-solid fa-users" aria-hidden="true"></i> {{ about.tag }}</span>
                {% endif %}
                <h2 class="section-title"><i class="fa-solid fa-seedling" aria-hidden="true"></i> {{ about.title }}</h2>
                {% if about.subtitle %}
                <p class="section-subtitle">{{ about.subtitle }}</p>
                {% endif %}
            </div>

            <div class="about-grid">
                <div class="about-text-column">
                    {% for paragraph in about.paragraphs %}
                    <p class="about-paragraph">{{ paragraph }}</p>
                    {% endfor %}
                    <div class="about-quote-card">
                        <i class="fa-solid fa-quote-left quote-icon" aria-hidden="true"></i>
                        <p class="quote-text">Não estamos aqui apenas por código. Estamos aqui pelas conexões humanas que o código torna possíveis.</p>
                        <span class="quote-author">— Comunidade Python</span>
                    </div>
                </div>

                {% if about.stats %}
                <div class="about-stats-column">
                    <div class="stats-grid">
                        {% for stat in about.stats %}
                        <div class="stat-card">
                            <div class="stat-icon-wrapper">
                                <i class="{{ stat.icon }}" aria-hidden="true"></i>
                            </div>
                            <div class="stat-number">{{ stat.number }}</div>
                            <div class="stat-label">{{ stat.label }}</div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Galeria de Fotos de Parnaíba -->
    <section id="destination" class="destination-section">
        <div class="section-header">
            <span class="section-tag"><i class="fa-solid fa-compass" aria-hidden="true"></i> Destino {{ event.edition }}</span>
            <h2 class="section-title"><i class="fa-solid fa-umbrella-beach" aria-hidden="true"></i> Parnaíba espera por você</h2>
            <p class="section-subtitle">
                O litoral do Piauí combina natureza exuberante, dunas paradisíacas e o acolhimento caloroso da nossa comunidade.
            </p>
        </div>

        <div class="phb-photos" id="phb-photos">
            <div class="phb-photos-carousel">
                <!-- Imagens injetadas via JavaScript -->
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block extra_js %}
    <script src="./static/js/phb_photos_animation.js"></script>
    <script src="./static/js/hero_animations.js"></script>
{% endblock %}