<!DOCTYPE html>
<html lang="pt-br">
{% set event_name = event.name if event and event.name else 'Python Nordeste' %}
{% set event_edition = event.edition if event and event.edition else (year | default('2027')) %}
{% set event_city = event.location.city if event and event.location and event.location.city else (city | default('')) %}
{% set event_state = event.location.state if event and event.location and event.location.state else (state | default('')) %}
{% set event_desc = event.description if event and event.description else (event_description | default('')) %}
{# Descrição curta para buscadores e previews de redes sociais (event.meta_description) #}
{% set event_meta_desc = event.meta_description if event and event.meta_description else (event_name ~ ' ' ~ event_edition ~ ((' em ' ~ event_city ~ ', ' ~ event_state) if event_city else '') ~ '. ' ~ event_desc) %}
{% set event_url = event.url if event and event.url else ('https://' ~ event_edition ~ '.pythonnordeste.org/') %}
{% set event_preview_image = theme.preview_image if theme and theme.preview_image else (preview_image | default('static/img/logo_pyne2027.png')) %}
{# Redes sociais (Facebook, LinkedIn, WhatsApp, X) exigem URL absoluta na og:image #}
{% set event_preview_image_url = event_preview_image if event_preview_image.startswith('http') else (event_url.rstrip('/') ~ '/' ~ event_preview_image.lstrip('/')) %}
{% set event_preview_image_alt = theme.preview_image_alt if theme and theme.preview_image_alt else ('Logo oficial da ' ~ event_name ~ ' ' ~ event_edition) %}
{% set event_title = event_name ~ ' ' ~ event_edition ~ ((' | ' ~ event_city ~ ' - ' ~ event_state) if event_city else '') %}
{% set event_favicon = theme.favicon if theme and theme.favicon else (favicon | default('static/img/favicon.png')) %}
{% set is_indexing_allowed = (environment != 'staging') and (allow_indexing | default(true)) %}
<head>
    <!-- Google tag (gtag.js) - Apenas em produção quando a indexação for permitida -->
    {% if google_tag and is_indexing_allowed %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ google_tag }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ google_tag }}');
    </script>
    {% endif %}

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="{{ event_meta_desc }}">
    <meta name="keywords" content="python, {{ event_name | lower }}, programacao, pyladies, {{ event_city | lower }}, {{ event_state | lower }}, {{ event_edition }}, evento, tecnologia, inclusao">
    
    <!-- Controle de Indexação para Motores de Busca (Google, Bing, etc.) -->
    {% if is_indexing_allowed %}
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <link rel="canonical" href="{{ event_url }}">
    {% else %}
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet">
    {% endif %}

    <meta name="author" content="Comunidade {{ event_name }}">
    
    <title>{% block title %}{{ event_title }}{% endblock %}</title>

    <!-- Open Graph: preview de links no Facebook, LinkedIn, WhatsApp, Telegram, etc. -->
    <meta property="og:title" content="{{ event_title }}">
    <meta property="og:description" content="{{ event_meta_desc }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ event_url }}">
    <meta property="og:image" content="{{ event_preview_image_url }}">
    {% if event_preview_image_url.startswith('https://') %}
    <meta property="og:image:secure_url" content="{{ event_preview_image_url }}">
    {% endif %}
    {% if theme and theme.preview_image_width and theme.preview_image_height %}
    <meta property="og:image:width" content="{{ theme.preview_image_width }}">
    <meta property="og:image:height" content="{{ theme.preview_image_height }}">
    {% endif %}
    <meta property="og:image:alt" content="{{ event_preview_image_alt }}">
    <meta property="og:site_name" content="{{ event_title }}">
    <meta property="og:locale" content="pt_BR">

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ event_title }}">
    <meta name="twitter:description" content="{{ event_meta_desc }}">
    <meta name="twitter:image" content="{{ event_preview_image_url }}">
    <meta name="twitter:image:alt" content="{{ event_preview_image_alt }}">
    
    <link rel="icon" href="{{ event_favicon }}" type="image/png">
    <link rel="apple-touch-icon" href="static/img/apple-touch-icon.png">

    <!-- Google Fonts: Outfit (Display) & Plus Jakarta Sans (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: {{ theme.primary_color if theme and theme.primary_color else '#E47A9F' }};
            --secondary-color: {{ theme.secondary_color if theme and theme.secondary_color else '#D4638A' }};
            --accent-color: {{ theme.accent_color if theme and theme.accent_color else '#F9F4E8' }};
            --text-dark: {{ theme.text_dark if theme and theme.text_dark else '#2B1B22' }};
            --font-display: 'Outfit', sans-serif;
            --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
    </style>

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="static/css/main.css">
    {% block extra_css %}
    {% endblock %}

</head>
<body>
    {% block navbar %}
    {% set repo_url = github_repo_url | default(social.github if social and social.github else '') %}
    <header id="site-header" class="site-header">
        <nav class="navbar" id="navbar" aria-label="Navegação Principal">
            <div class="navbar-container">
                <a href="index.html#hero" class="navbar-brand" aria-label="{{ event_name }} {{ event_edition }}">
                    <img src="{{ theme.logo }}" alt="Logo Oficial {{ event_name }}" class="navbar-logo" width="38" height="38">
                    <span class="navbar-brand-text">{{ event_name }} <span class="navbar-edition">{{ event_edition }}</span></span>
                </a>

                <div class="navbar-menu" id="navbar-menu">
                    <ul class="navbar-links">
                        {% if nav and nav.links %}
                            {% for link in nav.links %}
                            <li><a href="{{ link.url }}" class="nav-link">{{ link.label }}</a></li>
                            {% endfor %}
                        {% else %}
                            <li><a href="index.html#hero" class="nav-link">Início</a></li>
                            <li><a href="index.html#about" class="nav-link">Sobre</a></li>
                            <li><a href="index.html#destination" class="nav-link">Destino</a></li>
                            <li><a href="cdc.html" class="nav-link">Código de Conduta</a></li>
                        {% endif %}
                    </ul>

                    <div class="navbar-actions">
                        <div class="navbar-social">
                            {% if social.instagram %}
                            <a href="{{ social.instagram }}" target="_blank" rel="noopener noreferrer" class="nav-social-icon" aria-label="Instagram da PyNE">
                                <i class="fa-brands fa-instagram" aria-hidden="true"></i>
                            </a>
                            {% endif %}
                            {% if social.linkedin %}
                            <a href="{{ social.linkedin }}" target="_blank" rel="noopener noreferrer" class="nav-social-icon" aria-label="LinkedIn da PyNE">
                                <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
                            </a>
                            {% endif %}
                            {% if social.youtube %}
                            <a href="{{ social.youtube }}" target="_blank" rel="noopener noreferrer" class="nav-social-icon" aria-label="YouTube da PyNE">
                                <i class="fa-brands fa-youtube" aria-hidden="true"></i>
                            </a>
                            {% endif %}
                            {% if repo_url %}
                            <a href="{{ repo_url }}" target="_blank" rel="noopener noreferrer" class="nav-social-icon" aria-label="Repositório do projeto no GitHub">
                                <i class="fa-brands fa-github" aria-hidden="true"></i>
                            </a>
                            {% endif %}
                        </div>

                        {% if actions and actions.tickets_url %}
                        <a href="{{ actions.tickets_url }}" target="_blank" rel="noopener noreferrer" class="btn-nav-cta">
                            <i class="fa-solid fa-ticket" aria-hidden="true"></i> Ingressos
                        </a>
                        {% endif %}
                    </div>
                </div>

                <button class="navbar-toggle" id="navbar-toggle" aria-expanded="false" aria-controls="navbar-menu" aria-label="Alternar menu de navegação">
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                </button>
            </div>

            <!-- Linha de navegação com o Guará sobrevoando / Scroll progress -->
            <div class="nav-guara-stream" id="nav-guara-stream" aria-hidden="true">
                <div class="stream-line" id="stream-line"></div>
                <div class="stream-guara-pilot" id="stream-guara-pilot" title="Guará-vermelho acompanhando sua navegação">
                    <div class="guara-flapper nav-pilot-flapper">
                        <img src="static/img/guara/guara_up.png" alt="" class="guara-frame frame-up" />
                        <img src="static/img/guara/guara_down.png" alt="" class="guara-frame frame-down" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    {% endblock %}

    {% block content %}
    {% endblock %}

    {% block footer %}
    {% set repo_url = github_repo_url | default(social.github if social and social.github else '') %}
    {% set cdc_link = 'cdc.html' if code_of_conduct and code_of_conduct.page_url else (code_of_conduct_url | default('#')) %}
    <footer id="footer">
        <div class="footer-content">
            <div class="footer-brand-emblem" aria-hidden="true">
                <img src="static/img/brand/monograma.svg" alt="" class="footer-emblem-icon" width="46" height="46" />
            </div>

            {% if cdc_link %}
            <p class="footer-cdc">
                <i class="fa-solid fa-shield-heart" aria-hidden="true"></i> Este evento segue o 
                <a href="{{ cdc_link }}">
                    Código de Conduta da Comunidade Python
                </a>.
            </p>
            {% endif %}

            {% if repo_url %}
            <div class="footer-repo">
                <a href="{{ repo_url }}" target="_blank" rel="noopener noreferrer" class="footer-github-link" id="footer-github-link" aria-label="Repositório do projeto no GitHub">
                    <i class="fa-brands fa-github" aria-hidden="true"></i>
                    <span>Código aberto no GitHub</span>
                </a>
            </div>
            {% endif %}

            <p class="footer-sub">
                {{ event_name }} {{ event_edition }} • Parnaíba/PI • Feito com <i class="fa-solid fa-heart footer-heart" aria-hidden="true"></i> pela comunidade
            </p>
        </div>
    </footer>
    {% endblock %}

    <aside id="guara-nav-companion" class="guara-nav-companion" aria-label="Guará companheiro de navegação">
        <div class="companion-bubble" id="companion-bubble">
            <span class="companion-section-tag" id="companion-section-tag">Delta do Parnaíba</span>
            <span class="companion-text" id="companion-text">Sobrevoando o evento... 🪶</span>
        </div>
        <button class="companion-flyer-btn" id="btn-guara-top" title="Voar de volta ao topo com o Guará" aria-label="Voltar ao topo da página">
            <div class="guara-flapper companion-flapper">
                <img src="static/img/guara/guara_up.png" alt="" class="guara-frame frame-up" />
                <img src="static/img/guara/guara_down.png" alt="Guará navegando com você" class="guara-frame frame-down" />
            </div>
            <span class="companion-hover-hint"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></span>
        </button>
    </aside>

    <script src="static/js/navbar.js"></script>
    <script src="static/js/guara_animation.js"></script>
    {% block extra_js %}
    {% endblock %}
</body>
</html>